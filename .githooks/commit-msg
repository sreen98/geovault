#!/bin/sh
# Rejects commits that credit Claude / Anthropic as author, committer or co-author.
# Enable once per clone with:  git config core.hooksPath .githooks

msg_file="$1"
pattern='claude|anthropic'
failed=0

# Co-author trailers and generated-by footers in the message (comment lines ignored).
offending=$(grep -v '^#' "$msg_file" | grep -inE "^[[:space:]]*co-authored-by:.*($pattern)|generated with .*claude" )
if [ -n "$offending" ]; then
  echo "commit-msg: Claude/Anthropic attribution is not allowed in commit messages:" >&2
  echo "$offending" | sed 's/^/  /' >&2
  failed=1
fi

# Author and committer identity.
for role in AUTHOR COMMITTER; do
  ident=$(git var "GIT_${role}_IDENT" 2>/dev/null | sed 's/ [0-9]* [-+][0-9]*$//')
  if echo "$ident" | grep -iqE "$pattern"; then
    echo "commit-msg: $(echo "$role" | tr 'A-Z' 'a-z') must not be Claude/Anthropic (got: $ident)" >&2
    failed=1
  fi
done

if [ "$failed" -ne 0 ]; then
  echo "Remove the attribution and commit again." >&2
  exit 1
fi
exit 0
